{
  "info": {
    "_postman_id": "c45e9673-62ca-4af4-8d3c-e245ed6e8d20",
    "name": "Taskora Backend CRUD Testleri",
    "description": "Taskora Backend teslimi için sıralı CRUD istekleri. 01 numaralı istek yeni görev ID'sini taskId koleksiyon değişkenine kaydeder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "4",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Görev Oluştur",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created döner', function () { pm.response.to.have.status(201); });",
              "const task = pm.response.json();",
              "pm.collectionVariables.set('taskId', String(task.id));",
              "pm.test('Görev alanları doğru döner', function () {",
              "  pm.expect(task.title).to.eql('Postman API testi');",
              "  pm.expect(task.status).to.eql('pending');",
              "  pm.expect(task).to.have.property('createdAt');",
              "  pm.expect(task).to.have.property('updatedAt');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman API testi\",\n  \"description\": \"CRUD isteklerini kontrol et\",\n  \"status\": \"pending\",\n  \"priority\": \"high\",\n  \"assignee\": \"Yiğit Kaan Bilir\",\n  \"projectId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/tasks",
        "description": "Yeni görev oluşturur ve dönen ID'yi taskId değişkenine kaydeder."
      }
    },
    {
      "name": "02 - Görevleri Listele",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK döner', function () { pm.response.to.have.status(200); });",
              "pm.test('Cevap görev dizisidir', function () {",
              "  const tasks = pm.response.json();",
              "  pm.expect(tasks).to.be.an('array');",
              "  pm.expect(tasks.some(task => String(task.id) === pm.collectionVariables.get('taskId'))).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks",
        "description": "Tüm görevleri listeler."
      }
    },
    {
      "name": "03 - Görev Detayı",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK döner', function () { pm.response.to.have.status(200); });",
              "pm.test('Doğru görev döner', function () {",
              "  const task = pm.response.json();",
              "  pm.expect(String(task.id)).to.eql(pm.collectionVariables.get('taskId'));",
              "  pm.expect(task.title).to.eql('Postman API testi');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "description": "POST isteğinde oluşturulan görevin detayını getirir."
      }
    },
    {
      "name": "04 - Görev Güncelle",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK döner', function () { pm.response.to.have.status(200); });",
              "pm.test('Durum ve öncelik güncellenir', function () {",
              "  const task = pm.response.json();",
              "  pm.expect(task.status).to.eql('in_progress');",
              "  pm.expect(task.priority).to.eql('medium');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\",\n  \"priority\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "description": "Oluşturulan görevin durumunu ve önceliğini günceller."
      }
    },
    {
      "name": "05 - Görev Sil",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK döner', function () { pm.response.to.have.status(200); });",
              "pm.test('Başarı mesajı döner', function () {",
              "  pm.expect(pm.response.json().message).to.eql('Görev başarıyla silindi.');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "description": "POST isteğinde oluşturulan görevi siler."
      }
    }
  ]
}
